/* Simple dark theme for Org HTML export (Geometry-style) */
:root {
  --bg: #0d1117;
  --bg2: #161b22;
  --card: #1c2128;
  --text: #e6edf3;
  --muted: #9da7b3;
  --accent: #58a6ff;
  --accent2: #7ee787;
  --border: #30363d;
  --code: #0b1220;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.75;
  font-size: 15px;
}
#content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}
.title {
  color: var(--text);
  font-size: 2.1rem;
  font-weight: 700;
  border-bottom: 2px solid var(--border);
  padding-bottom: 16px;
  margin-bottom: 8px;
}
.subtitle, #author, .date, .timestamp { color: var(--muted); font-size: 0.95rem; }

/* Headings only — not body copy */
#content h2,
.outline-2 > h2 {
  color: var(--accent);
  font-size: 1.35rem;
  font-weight: 700;
  margin: 2.2rem 0 0.75rem;
  padding-bottom: 0.35rem;
  border-bottom: 1px solid var(--border);
}
#content h3,
.outline-3 > h3 {
  color: var(--accent2);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 1.5rem 0 0.5rem;
}
#content h4,
.outline-4 > h4 {
  color: var(--accent2);
  font-size: 1rem;
  font-weight: 600;
  margin: 1rem 0 0.4rem;
}

/* Body text — explicit normal weight/size (fixes unclosed-h2 bleed) */
.outline-text-2,
.outline-text-3,
.outline-text-4 {
  color: var(--text);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.75;
}
.outline-text-2 p,
.outline-text-3 p,
.outline-text-4 p,
.outline-text-2 li,
.outline-text-3 li,
.outline-text-4 li,
.outline-text-2 td,
.outline-text-3 td {
  color: var(--text);
  font-size: 15px;
  font-weight: 400;
}

.heading-permalink { display: none !important; }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
p { margin: 0 0 0.9rem; }
ul, ol { margin: 0 0 1rem; padding-left: 1.4rem; }
li { margin-bottom: 0.35rem; }

#table-of-contents { display: none; }

code {
  font-family: ui-monospace, "Cascadia Code", "Fira Code", monospace;
  font-size: 0.88em;
  background: var(--code);
  padding: 0.12em 0.35em;
  border-radius: 4px;
}
.org-src-container {
  position: relative;
  width: 100%;
  max-width: 100%;
  margin: 0.75rem 0 1.25rem;
}
.org-src-container.has-copy-btn pre,
.org-src-container pre {
  display: block;
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 16px 18px;
  background: var(--code);
  color: #dbeafe;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow-x: auto;
  line-height: 1.55;
  font-size: 0.88rem;
  white-space: pre;
}
.org-src-container.has-copy-btn pre {
  padding-top: 38px;
}
.code-copy-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  font-family: inherit;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  padding: 5px 11px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--card);
  color: var(--muted);
  cursor: pointer;
}
.code-copy-btn:hover {
  color: var(--text);
  border-color: var(--accent);
}

table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 0.75rem 0 1.25rem; }
th, td { border: 1px solid var(--border); padding: 10px 12px; text-align: left; vertical-align: top; }
th { background: #1e293b; color: var(--accent); }
blockquote {
  background: var(--bg2);
  border-left: 4px solid var(--accent2);
  padding: 14px 18px;
  margin: 1rem 0 1.5rem;
  border-radius: 6px;
}
hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
img { max-width: 100%; height: auto; border-radius: 6px; }
#postamble, #text-footnotes {
  color: var(--muted);
  font-size: 0.88rem;
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}
